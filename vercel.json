{
  "version": 2,
  "buildCommand": "echo 'Dependencies installed'",
  "env": {
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/[...path].js": {
      "memory": 1024,
      "maxDuration": 300
    }
  }
}
