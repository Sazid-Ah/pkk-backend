# Server
NODE_ENV=production
PORT=8080

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxx.mongodb.net/pkk_db

# JWT - generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<64-char-random-hex>
JWT_REFRESH_SECRET=<64-char-random-hex>

# Initial admin/bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong-password>
SETUP_SECRET=<random-setup-secret>

# SMTP email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-email@domain.com>
SMTP_PASSWORD=<app-specific-password>
SMTP_FROM_NAME=PKK App
SMTP_FROM_EMAIL=<your-email@domain.com>

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=<razorpay-secret>

# CORS - comma-separated allowed frontend/admin origins
ALLOWED_ORIGINS=https://your-admin-domain.com,https://your-app-domain.com

# OTP
OTP_EXPIRY_MINUTES=10

# Web Push (optional) — generate a pair with: npx web-push generate-vapid-keys
# The public key must match the frontend's NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Leave unset to disable push (notifications still save + show in-app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@panditkathakalyan.com
